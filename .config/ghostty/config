#THEME
theme = aura
# theme = catpuccin-mocha
# theme = cursor-dark
# theme = darkmatrix
# theme = duckbones

#OPACITY
background-opacity = 0.85
background-opacity-cells = true

#KEYBINDS
keybind = shift+cmd+z=close_surface

keybind = shift+cmd+h=new_split:left
keybind = shift+cmd+j=new_split:down
keybind = shift+cmd+k=new_split:up
keybind = shift+cmd+l=new_split:right

# performable: Ghostty only takes ctrl+hjkl when there's a Ghostty split to move to.
# Otherwise the key passes through to tmux (vim-tmux-navigator) and Neovim.
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:bottom
keybind = performable:ctrl+k=goto_split:top
keybind = performable:ctrl+l=goto_split:right

keybind = shift+cmd+,=reload_config

keybind = global:cmd+grave_accent=toggle_quick_terminal

#TMUX
# Uncomment to land in tmux on every new window/tab. Left off so the quick
# terminal stays a plain throwaway shell.
# command = /opt/homebrew/bin/tmux new-session -A -s main
